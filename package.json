{
  "name": "briefkit-mcp-server",
  "version": "1.0.1",
  "description": "MCP server for BriefKit — generates engineer-grade SaaS specification briefs for AI build tools like Lovable, Claude Code, and Cursor",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "briefkit-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "briefkit", "saas", "lovable", "cursor", "ai-build-tools", "specification"],
  "author": "BriefKit",
  "license": "MIT"
}
